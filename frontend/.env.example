NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Exact Supabase origin that serves public product media, for example:
# NEXT_PUBLIC_IMAGE_ORIGIN=https://PROJECT.supabase.co
# Payment gateway shown at checkout: razorpay (default) or fss (bank hosted page, needs backend FSS_ENABLED=true).
NEXT_PUBLIC_PAYMENT_GATEWAY=razorpay
# Build-time CSP form-action allow-list for bank hosted payment pages, comma-separated HTTPS origins.
PAYMENT_FORM_ACTION_ORIGINS=
