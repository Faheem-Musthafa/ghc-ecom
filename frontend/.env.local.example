# The backend owns Supabase service credentials, pricing, and Razorpay secrets.
# Only the public API origin belongs in the browser bundle.
# Browser requests use the same-origin Next.js proxy.
NEXT_PUBLIC_API_URL=/api/v1
# Server Components call the API directly. Override these in deployment.
BACKEND_ORIGIN=http://127.0.0.1:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
